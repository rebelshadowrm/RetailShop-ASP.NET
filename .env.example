ASPNETCORE_ENVIRONMENT=Development
DemoMode=true
DatabaseProvider=Sqlite

# Demo credentials only. Do not use these in production.
SeedUsers__Admin__Email=demo.admin@example.com
SeedUsers__Admin__Password=DemoAdmin123!
SeedUsers__Customer__Email=demo.customer@example.com
SeedUsers__Customer__Password=DemoCustomer123!

# SQL Server mode requires DemoMode=false plus these connection strings.
ConnectionStrings__AmazonSqlConnection=
ConnectionStrings__CommentDb=
ConnectionStrings__OrderHistoryDb=

# Heroku Postgres mode requires DemoMode=false, DatabaseProvider=Postgres,
# and DATABASE_URL from the Heroku Postgres add-on.
DATABASE_URL=
